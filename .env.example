# ─── AI KEYS ──────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=your_openai_key_here        # used for embeddings (text-embedding-3-small)

# ─── SEARCH (free — no key needed) ────────────────────────
# DuckDuckGo search is used by default — no API key required
# Optional: Tavily for higher quality search results
TAVILY_API_KEY=                            # optional, get free key at tavily.com

# ─── AGENT CONFIG ─────────────────────────────────────────
MAX_SEARCH_QUERIES=8          # how many search queries to generate per topic
MAX_SOURCES_PER_QUERY=5       # how many URLs to fetch per query
MAX_CONTENT_LENGTH=3000       # max chars per source to keep
RESEARCH_DEPTH=deep           # quick | standard | deep
ENABLE_CONTRADICTION_CHECK=true
ENABLE_VECTOR_SEARCH=true     # use FAISS to find related content across sources

# ─── OUTPUT ───────────────────────────────────────────────
OUTPUT_FORMAT=markdown         # markdown | json | both
REPORT_STYLE=academic          # academic | journalist | executive | simple
